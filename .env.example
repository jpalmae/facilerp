# ── Obligatorias ──────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-un-secret-aleatorio-seguro
DATABASE_URL=postgresql://facilerp:facilerp@db:5432/facilerp
POSTGRES_PASSWORD=facilerp

# ── Opcionales ────────────────────────────────────────────────
FLASK_ENV=production
POSTGRES_DB=facilerp
POSTGRES_USER=facilerp
UPLOAD_ROOT=/app/uploads/brand
MAX_CONTENT_LENGTH=5242880
LOG_LEVEL=INFO
PERMANENT_SESSION_LIFETIME_HOURS=8

# Brand storage: "local" o "supabase"
BRAND_STORAGE_BACKEND=local

# Supabase (solo si BRAND_STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=brand

# Proxy (detrás de nginx)
TRUST_PROXY_COUNT=1
SESSION_COOKIE_SECURE=true
REMEMBER_COOKIE_SECURE=true
PREFERRED_URL_SCHEME=https
ENABLE_HSTS=true

# Rate limiting (producción: usar Redis)
RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# Migraciones automáticas
AUTO_MIGRATE_ON_START=false
ENABLE_DEMO_BOOTSTRAP=false

# ── TLS/SSL ───────────────────────────────────────────────────
# Ruta local con certificados (fullchain.pem + privkey.pem)
SSL_CERT_DIR=./ssl
HTTP_PORT=80
HTTPS_PORT=443

# ── Backups ───────────────────────────────────────────────────
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30

# ── Externo ───────────────────────────────────────────────────
SUNAT_API_URL=https://api.sunat.gob.pe
SUNAT_API_TOKEN=
